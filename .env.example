# MarketLens Environment Configuration
# Primary market data provider: 0xramm Indian Stock Market API (v3.0)
# Repository: https://github.com/0xramm/Indian-Stock-Market-API
# Optional: Provide a custom or external 0xramm deployment base URL without trailing slash.
# If omitted, MarketLens automatically runs the embedded 0xramm v3.0 engine with live Yahoo Finance feeds.
# MARKET_API_BASE_URL=https://your-0xramm-instance.workers.dev

# Public App Metadata
NEXT_PUBLIC_APP_NAME=MarketLens
NEXT_PUBLIC_DEFAULT_MARKET=India

# Polling Interval (in milliseconds, default 30000 = 30 seconds)
MARKET_REFRESH_INTERVAL_MS=30000
