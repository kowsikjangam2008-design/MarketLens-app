# MarketLens Environment Configuration
# Primary market data provider: 0xramm Indian Stock Market API
# Repository: https://github.com/0xramm/Indian-Stock-Market-API
# Provide your self-hosted or deployed 0xramm instance URL without trailing slash:
MARKET_API_BASE_URL=https://indian-stock-market-api.vercel.app

# Public App Metadata
NEXT_PUBLIC_APP_NAME=MarketLens
NEXT_PUBLIC_DEFAULT_MARKET=India

# Polling Interval (in milliseconds, default 30000 = 30 seconds)
MARKET_REFRESH_INTERVAL_MS=30000
